+
+
+test('fireChance and expectedLoad count probability and group entries by their chance', () => {
+    const mk = (uid, o = {}) => ({ uid, content: 'x'.repeat(400), useProbability: true, probability: 100, ...o });
+    assert.equal(fireChance(mk(0)), 1);
+    assert.equal(fireChance(mk(1, { probability: 30 })), 0.3);
+    assert.equal(fireChance(mk(2, { probability: 30, useProbability: false })), 1);
+    // 20 entries of 100 tokens at 10% = 2 entries / 200 tokens on average, not 20 / 2000
+    const rnd = Array.from({ length: 20 }, (_, i) => mk(i, { probability: 10 }));
+    const L = expectedLoad(rnd);
+    assert.ok(Math.abs(L.n - 2) < 1e-9 && Math.abs(L.tokens - 200) < 1e-9);
+    // an inclusion group of 5 always-matching entries counts as one entry
+    const grp = Array.from({ length: 5 }, (_, i) => mk(i, { group: 'weather' }));
+    assert.ok(Math.abs(expectedLoad(grp).n - 1) < 1e-9);
+    // constants count in full
+    assert.equal(expectedLoad([mk(0, { constant: true, probability: 10 })]).n, 1);
+    // the brake no longer trips for them, but still trips for always-firing entries
+    const lim = { maxEntries: 5, maxTokens: 100000 };
+    assert.equal(trimToLimits(rnd, lim, expectedLoad(rnd).weight).drop.length, 0);
+    assert.equal(trimToLimits(rnd, lim).drop.length, 15);
+});
